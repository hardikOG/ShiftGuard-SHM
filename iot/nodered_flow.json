[
  {
    "id": "sg_tab",
    "type": "tab",
    "label": "ShiftGuard SHM alerts",
    "disabled": false,
    "info": "Receives ShiftGuard alerts over MQTT and emails the maintenance engineer.\nOnly STRUCTURAL_DAMAGE and SENSOR_FAULT alerts are emailed; ENVIRONMENT and NORMAL go to the debug log."
  },
  {
    "id": "sg_broker",
    "type": "mqtt-broker",
    "name": "ShiftGuard broker",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered-shiftguard",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "sg_in",
    "type": "mqtt in",
    "z": "sg_tab",
    "name": "ShiftGuard alerts",
    "topic": "shm/+/alert",
    "qos": "1",
    "datatype": "json",
    "broker": "sg_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 120,
    "wires": [["sg_route"]]
  },
  {
    "id": "sg_route",
    "type": "switch",
    "z": "sg_tab",
    "name": "route by attribution",
    "property": "payload.label",
    "propertyType": "msg",
    "rules": [
      {"t": "eq", "v": "STRUCTURAL_DAMAGE", "vt": "str"},
      {"t": "eq", "v": "SENSOR_FAULT", "vt": "str"},
      {"t": "else"}
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 3,
    "x": 360,
    "y": 120,
    "wires": [["sg_fmt"], ["sg_fmt"], ["sg_debug"]]
  },
  {
    "id": "sg_fmt",
    "type": "function",
    "z": "sg_tab",
    "name": "format email",
    "func": "const a = msg.payload;\nconst urgent = a.label === 'STRUCTURAL_DAMAGE';\nmsg.topic = (urgent ? '[URGENT] Structural damage alarm - ' : '[MAINTENANCE] Sensor fault - ') + a.bridge;\nmsg.payload = `ShiftGuard SHM alert\\n\\nBridge: ${a.bridge}\\nBridge hour: ${a.t_hours}\\nAttribution: ${a.label}\\nTemperature: ${a.temp} C\\n\\n${a.message}\\n\\nThis alert was raised by an anytime-valid conformal e-detector: on a healthy structure the expected time to a false alarm exceeds the configured threshold.`;\nreturn msg;",
    "outputs": 1,
    "x": 580,
    "y": 100,
    "wires": [["sg_mail", "sg_debug"]]
  },
  {
    "id": "sg_mail",
    "type": "e-mail",
    "z": "sg_tab",
    "server": "smtp.gmail.com",
    "port": "465",
    "secure": true,
    "tls": true,
    "name": "maintenance.engineer@example.com",
    "dname": "Email maintenance engineer",
    "x": 830,
    "y": 80,
    "wires": []
  },
  {
    "id": "sg_debug",
    "type": "debug",
    "z": "sg_tab",
    "name": "alert log",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "x": 800,
    "y": 160,
    "wires": []
  }
]
